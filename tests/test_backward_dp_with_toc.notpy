import torch
import numpy as np
import networkx as nx
from datetime import datetime
from equinox.dp.backward_dp_w_grad import run_backward_dp
from equinox.helpers.datetimeh import datestr_to_seconds_since_midnight, seconds_since_midnight_to_datetime
from equinox.cost.cost_rev1 import CostRev1
from equinox.cost.cost_model_1 import cost_model_1
from equinox.wind.wind_date import WindDate
from equinox.vnav.vnav_performance import Performance
from equinox.vnav.vnav_profiles_rev1 import NARROW_BODY_JET_CLIMB_PROFILE, NARROW_BODY_JET_DESCENT_PROFILE, NARROW_BODY_JET_CLIMB_VS_PROFILE, NARROW_BODY_JET_DESCENT_VS_PROFILE

def test_backward_dp_with_toc():
    
    print('Test: Backward Dynamic Programming (backward_dp_vec2) with ToC')

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")

    # Load the route graph
    G = nx.read_gml("data/graph/LEMD_EGLL_2023_04_01.gml")

    node_list_for_matrix = list(G.nodes()) # Consistent order for matrix indexing
    # node_to_idx_for_matrix = {nid: i for i, nid in enumerate(node_list_for_matrix)} # Not directly used in this test script main flow
    num_actual_nodes = len(node_list_for_matrix)

    # Load the distance matrix
    dist_matrix = np.load("data/graph/LEMD_EGLL_2023_04_01_distances.npy")
    
    # Load the airspace charges matrix
    ac_matrix = np.load("data/graph/LEMD_EGLL_2023_04_01_charges.npy")

    # Load the wind model
    # Consistent with test_forward_dp, using a 2024 date for wind data,
    # while flight times (landing time here) are for 2023.
    wind_model = WindDate(date_str="2024-04-01", data_dir="data/era5")

    # Load the performance model for a typical narrow body jet
    performance_model = Performance(
        climb_speed_profile=NARROW_BODY_JET_CLIMB_PROFILE,
        descent_speed_profile=NARROW_BODY_JET_DESCENT_PROFILE,
        climb_vertical_speed_profile=NARROW_BODY_JET_CLIMB_VS_PROFILE,
        descent_vertical_speed_profile=NARROW_BODY_JET_DESCENT_VS_PROFILE,
        cruise_altitude_ft=35000.0,
        cruise_speed_kts=450.0,
    )

    # Load the cost model
    cost_model_instance = cost_model_1
    
    # Estimated landing time
    estimated_landing_time_str = "2023-04-01 12:00:00" # Similar to takeoff time in forward DP for wind consistency

    # Estimated takeoff time
    estimated_takeoff_time_str = "2023-04-01 10:25:17"
    estimated_takeoff_eta = datestr_to_seconds_since_midnight(estimated_takeoff_time_str)
    try:
        # For backward DP, origin_elevation_ft refers to the flight's actual origin (LEMD)
        # and destination_elevation_ft refers to the flight's actual destination (EGLL, the goal_node_id here)
        # final_alt_ft is the altitude at the goal_node_id (EGLL) at estimated_landing_time_str.
        # If final_alt_ft is 0.0 (default), it uses destination_elevation_ft.
        V_final, eta_final, alt_final, phase_final, edge_costs_time_binned, edge_cost_gradients_time_binned, edge_to_canonical_idx = run_backward_dp(
            graph=G,
            goal_node_id="EGLL", # Destination for the flight
            estimated_landing_time_str=estimated_landing_time_str,
            origin_elevation_ft=0.0, # Assuming LEMD at sea level for profile context
            destination_elevation_ft=0.0, # Assuming EGLL at sea level
            cost_model=cost_model_instance,
            wind_model=wind_model,
            performance_model=performance_model,
            dist_matrix_np=dist_matrix,
            ac_matrix_np=ac_matrix,
            final_alt_ft=0.0, # Altitude at EGLL at landing time, defaults to destination_elevation_ft if 0.0
            delta_t_seconds=600, # time window length
            max_flight_duration_hours=5, # max duration to consider for time bins
            device=device,
            temperature=5e-3,
            takeoff_eta=estimated_takeoff_eta # for Top of Climb handling
        )

        print("\n--- Results ---")
        print(f"V function shape: {V_final.shape}")
        
        # Base time string for interpreting ETA values (seconds since midnight)
        # The date part is used to correctly convert SSM to a full datetime object
        # For backward DP, eta_final contains ETAs at each node (u) if that path is taken to the goal.
        # The date context for these ETAs should match the date of estimated_landing_time_str.
        base_output_time_str = estimated_landing_time_str.split(" ")[0] # "YYYY-MM-DD" part

        # Optional: Print some values from the results
        # for node_idx_res in range(num_actual_nodes):
        #     for time_idx_res in range(V_final.shape[1]):
        #         if not torch.isinf(V_final[node_idx_res, time_idx_res]):
        #             node_id_res = node_list_for_matrix[node_idx_res]
                    
        #             # active_eta contains seconds since midnight for the date of estimated_landing_time_str
        #             active_eta_val = eta_final[node_idx_res, time_idx_res].item()
        #             active_alt_val = alt_final[node_idx_res, time_idx_res].item()
        #             active_phase_val = phase_final[node_idx_res, time_idx_res].item()

        #             # The time bin itself (time_idx_res) represents a departure time from node_id_res,
        #             # if working backwards. The eta_final is the specific ETA at node_id_res.
        #             # Displaying the time bin's meaning might be complex here without knowing min_time_overall_seconds
        #             # from inside run_backward_dp. So, focusing on active_eta_val.

        #             print(f"Node {node_id_res} ({node_idx_res}), Time Bin {time_idx_res}:")
        #             print(f"  V (Cost-to-go) = {V_final[node_idx_res, time_idx_res].item():.2f}")
        #             print(f"  ETA at this node: {seconds_since_midnight_to_datetime(base_output_time_str, active_eta_val).strftime('%Y-%m-%d %H:%M:%S') if not np.isnan(active_eta_val) else 'N/A'}")
        #             print(f"  Altitude (ft) at this node: {active_alt_val if not np.isnan(active_alt_val) else 'N/A'}")
        #             print(f"  Phase at this node: {active_phase_val if active_phase_val != -1 else 'N/A'}")


        # Dump the value function V and other tensors to files
        import os

        output_dir = "data/results/backward"
        os.makedirs(output_dir, exist_ok=True)
        np.save(os.path.join(output_dir, "V_final_bw.npy"), V_final.cpu().detach().numpy())
        np.save(os.path.join(output_dir, "eta_final_bw.npy"), eta_final.cpu().detach().numpy())
        np.save(os.path.join(output_dir, "alt_final_bw.npy"), alt_final.cpu().detach().numpy())
        np.save(os.path.join(output_dir, "phase_final_bw.npy"), phase_final.cpu().detach().numpy())
        print(f"\nResults saved to {output_dir}")

    except Exception as e:
        print(f"An error occurred during the example run: {e}")
        import traceback
        traceback.print_exc()

if __name__ == '__main__':
    test_backward_dp_with_toc()
