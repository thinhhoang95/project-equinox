   "source": [
    "from equinox.training.prep.prep_graph import make_graph_acyclic, improve_connectivity, remove_isolated_nodes, remove_backtracking_edges, remove_collinear_edges, remove_unreachable_nodes\n",
    "from equinox.training.prep.graph_scripts.plot_graph import plot_graph\n",
    "Gno2 = Gno.copy()\n",
    "improve_connectivity(Gno2, 'LEMD', 'EGLL', n_iter=5)\n",
    "# Remove collinear edges\n",
    "Gno2 = remove_collinear_edges(Gno2)\n",
    "Gno2 = remove_backtracking_edges(Gno2, 'LEMD', 'EGLL', max_allowed_deviation_angle=75)\n",
    "Gno2 = remove_isolated_nodes(Gno2)\n",
    "Gno2 = remove_unreachable_nodes(Gno2, 'LEMD', 'EGLL')\n",
    "Gno2 = make_graph_acyclic(Gno2, 'LEMD', 'EGLL')\n",
    "print(f'The graph has {Gno2.number_of_nodes()} nodes and {Gno2.number_of_edges()} edges')\n",
    "plot_graph(Gno2, show_label=True, highlighted_labels=[])"
   ]
  },
