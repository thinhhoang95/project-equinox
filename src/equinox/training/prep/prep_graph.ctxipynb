   "source": [
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "\n",
    "import os\n",
    "from equinox.training.prep.prep_graph import prepare_base_graph\n",
    "\n",
    "path_prefix = '/Volumes/CrucialX/project-akrav/'\n",
    "nodes_only_graph_path = os.path.join(path_prefix, 'data', 'graphs', 'ats_fra_nodes_only.gml')\n",
    "source_id = 'LEMD'\n",
    "destination_id = 'EGLL'\n",
    "routes_dir = os.path.join(path_prefix, 'matched_filtered_data')\n",
    "\n",
    "import time\n",
    "start_time = time.time()\n",
    "Gno = prepare_base_graph(nodes_only_graph_path, source_id, destination_id, routes_dir,\n",
    "                         delete_isolated_nodes=False)\n",
    "print(f'Base graph completed in {time.time() - start_time} seconds')\n",
    "print(f'The graph has {Gno.number_of_nodes()} nodes and {Gno.number_of_edges()} edges')"
   ]
