from quasar_r12.geometry.cycle_prune import make_acyclic_by_bearing_and_degree
from quasar_r12.geometry.improve_connectivity import improve_graph_connectivity
from quasar_r12.geometry.collinear import refine_graph
n_iter = 10
Gx = Gm.copy()


for i in range(n_iter):
    
    orphan_goal_nodes = nodes_that_cannot_reach_goal(Gx, 'EGLL')
    orphan_source_nodes = nodes_that_source_cannot_reach(Gx, 'LEMD')

    print(f'Iteration {i}, there are {len(nodes_that_cannot_reach_goal(Gx, "EGLL"))} nodes that can not reach EGLL, {len(nodes_that_source_cannot_reach(Gx, "LEMD"))} nodes that can not be reached from LEMD')
    edge_before = Gx.number_of_edges()

    Gx = improve_graph_connectivity(Gx, orphan_goal_nodes, orphan_source_nodes,
                                    main_bearing=bearing,
                                    radius_nm=400,
                                    bearing_tolerance_deg=85,
                                    n_degree_connections=6,
                                    n_nearest_connections=2)
    
    
    if Gx.has_edge('LERJ', 'LPA'):
        print("1 Edge (LERJ, LPA) exists in Gx")

    has_path = nx.has_path(Gx, 'ULTIB', 'EGLL')
    print(f"1 >> Path from ULTIB to EGLL exists: {has_path}")

    # Refine the graph to satisfy collinearity condition
    for i in range(5):
        refine_graph(Gx, 1e-4, 1e-4)

    if Gx.has_edge('LERJ', 'LPA'):
        print("2 Edge (LERJ, LPA) exists in Gx")

    has_path = nx.has_path(Gx, 'ULTIB', 'EGLL')
    print(f"2 >> Path from ULTIB to EGLL exists: {has_path}")
    
    edge_after = Gx.number_of_edges()
    print(f'Number of edge changes: {edge_after - edge_before}')

    Gx = make_acyclic_by_bearing_and_degree(Gx, bearing)
    
    if Gx.has_edge('LERJ', 'LPA'):
        print("3 Edge (LERJ, LPA) exists in Gx")

    has_path = nx.has_path(Gx, 'ULTIB', 'EGLL')
    print(f"3 >> Path from ULTIB to EGLL exists: {has_path}")
    
    # Check if the graph is acyclic
    if is_acyclic(Gx):
        print(f'Graph is acyclic after iteration {i}')
    else:
        print(f'Graph is not acyclic after iteration {i}')



# %%
orphan_goal_nodes = nodes_that_cannot_reach_goal(Gx, 'EGLL')
orphan_source_nodes = nodes_that_source_cannot_reach(Gx, 'LEMD')

# %%
def remove_orphan_nodes(G, orphan_goal_nodes, orphan_source_nodes):
    """
    Remove all nodes in orphan_goal_nodes and orphan_source_nodes from the graph G.
    """
    to_remove = set(orphan_goal_nodes) | set(orphan_source_nodes)
    G.remove_nodes_from(to_remove)

remove_orphan_nodes(Gx, orphan_goal_nodes, orphan_source_nodes)


