# Bearing between source and goal 
def compute_bearing(lat1, lon1, lat2, lon2):
    """
    Compute the initial bearing (forward azimuth) from (lat1, lon1) to (lat2, lon2).
    All args in degrees. Returns bearing in degrees from North (0-360).
    """
    import math
    lat1_rad = math.radians(lat1)
    lat2_rad = math.radians(lat2)
    dlon_rad = math.radians(lon2 - lon1)
    x = math.sin(dlon_rad) * math.cos(lat2_rad)
    y = math.cos(lat1_rad) * math.sin(lat2_rad) - \
        math.sin(lat1_rad) * math.cos(lat2_rad) * math.cos(dlon_rad)
    bearing_rad = math.atan2(x, y)
    bearing_deg = (math.degrees(bearing_rad) + 360) % 360
    return bearing_deg

src = 'LEMD'
dst = 'EGLL'
if src in Gm.nodes and dst in Gm.nodes:
    lat1, lon1 = Gm.nodes[src]['lat'], Gm.nodes[src]['lon']
    lat2, lon2 = Gm.nodes[dst]['lat'], Gm.nodes[dst]['lon']
    bearing = compute_bearing(lat1, lon1, lat2, lon2)
    print(f"Bearing from {src} to {dst}: {bearing:.2f}°")
else:
    print(f"Source ({src}) or destination ({dst}) not found in graph.")


# %%
def remove_backtracking_edges(G, main_bearing, max_backtrack_angle=120):
    """
    Remove all edges from G that represent a 'backtrack' relative to the main bearing.
    Only allow the direction in the bearing of the main bearing (not the reverse direction).
    """
    import math

    def bearing_between(lat1, lon1, lat2, lon2):
        lat1_rad = math.radians(lat1)
        lat2_rad = math.radians(lat2)
        dlon_rad = math.radians(lon2 - lon1)
        x = math.sin(dlon_rad) * math.cos(lat2_rad)
        y = math.cos(lat1_rad) * math.sin(lat2_rad) - \
            math.sin(lat1_rad) * math.cos(lat2_rad) * math.cos(dlon_rad)
        bearing_rad = math.atan2(x, y)
        bearing_deg = (math.degrees(bearing_rad) + 360) % 360
        return bearing_deg

    def angle_diff(a, b):
        d = abs(a - b) % 360
        return min(d, 360 - d)

    edges_to_remove = []
    for u, v in G.edges():
        lat1 = G.nodes[u].get('lat')
        lon1 = G.nodes[u].get('lon')
        lat2 = G.nodes[v].get('lat')
        lon2 = G.nodes[v].get('lon')
        if None in (lat1, lon1, lat2, lon2):
            continue  # skip if missing coordinates
        edge_bearing = bearing_between(lat1, lon1, lat2, lon2)
        diff = angle_diff(main_bearing, edge_bearing)
        if diff > max_backtrack_angle:
            edges_to_remove.append((u, v))
    # Remove the edges
    G.remove_edges_from(edges_to_remove)
    if edges_to_remove:
        print(f"Removed {len(edges_to_remove)} backtracking edges (angle > {max_backtrack_angle}° from main bearing).")

